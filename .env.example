# =============================================================================
# Development Configuration
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
# Local: postgresql://user:password@localhost:5432/viber_chatbot
# Docker: automatically set via docker-compose.yml
DATABASE_URL=postgresql://user:password@localhost:5432/viber_chatbot

# Redis
# Local: redis://localhost:6379
# Docker: automatically set via docker-compose.yml
REDIS_URL=redis://localhost:6379

# Admin API
ADMIN_API_TOKEN=your-secret-admin-token-here

# Encryption key for tenant credentials (32 bytes hex = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Viber/Telegram webhook base URL (public-facing URL)
# Must be HTTPS in production for Viber webhook registration
WEBHOOK_BASE_URL=https://your-domain.com

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Chatwoot
# URL where your Chatwoot instance is running
CHATWOOT_BASE_URL=http://localhost:3000
# Shared secret for Chatwoot webhook verification
CHATWOOT_WEBHOOK_SECRET=

# CORS — comma-separated origins allowed for admin dashboard
CORS_ORIGIN=http://localhost:4200

# =============================================================================
# Production Configuration (docker-compose.prod.yml)
# =============================================================================
# Uncomment and fill in the values below when deploying to production.

# --- PostgreSQL credentials (used by docker-compose to create the database) ---
# POSTGRES_USER=viber_chatbot
# POSTGRES_PASSWORD=strong-password-here
# POSTGRES_DB=viber_chatbot

# --- Redis password ---
# REDIS_PASSWORD=strong-redis-password-here

# --- Chatwoot ---
# Secret key base for Rails (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CHATWOOT_SECRET_KEY_BASE=your-64-char-hex-string

# Public URL where Chatwoot is accessible (used for email links, etc.)
# If exposing on port 3001: https://your-domain.com:3001
# If using a subdomain: https://chatwoot.your-domain.com
# CHATWOOT_FRONTEND_URL=https://chatwoot.your-domain.com

# Chatwoot platform token (created via Chatwoot Super Admin → Platform Apps)
# CHATWOOT_PLATFORM_TOKEN=

# ActionCable URL for Chatwoot real-time WebSocket updates
# Should match CHATWOOT_FRONTEND_URL with wss:// protocol
# Example: wss://chatwoot.your-domain.com/cable
# ACTION_CABLE_URL=wss://chatwoot.your-domain.com/cable
