# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/viber_chatbot

# Redis
REDIS_URL=redis://localhost:6379

# Admin API
ADMIN_API_TOKEN=your-secret-admin-token-here

# Encryption key for tenant credentials (32 bytes hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Viber webhook base URL (public-facing URL)
WEBHOOK_BASE_URL=https://your-domain.com

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Chatwoot
CHATWOOT_BASE_URL=http://localhost:3000
# Chatwoot webhook URL (configure in Chatwoot → Settings → Integrations → Webhook)
# Format: https://your-domain.com/api/chatwoot/webhook
